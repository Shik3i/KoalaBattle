KOALABATTLE_DATABASE_URL=sqlite+aiosqlite:///./data/koalabattle.db
KOALABATTLE_SHOWDOWN_WEBSOCKET_URL=ws://localhost:8000/showdown/websocket
KOALABATTLE_SHOWDOWN_AUTH_URL=https://play.pokemonshowdown.com/action.php?
KOALABATTLE_TEAM_VALIDATOR_URL=http://localhost:8002
# Local LM Studio defaults: Docker uses host.docker.internal, host execution can use 127.0.0.1.
KOALABATTLE_ORCHESTRATOR_LOCAL_BASE_URL=http://host.docker.internal:1234/v1
KOALABATTLE_ORCHESTRATOR_DEFAULT_MODEL=google/gemma-4-e4b
KOALABATTLE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Unset (default) = no API auth, fine for a purely local single-operator setup. Set this to a
# long random secret to require `Authorization: Bearer <token>` (or `?token=` on websockets)
# on mutating/sensitive endpoints - do this before exposing the backend beyond localhost.
KOALABATTLE_API_TOKEN=
# Keep the full prompt/decision audit for this many of the most recent matches and drop
# it for older ones. 0 (default) keeps everything - the audit is the largest thing the
# database stores, but pruning deletes your own history, so it is opt-in. Replays,
# results and per-stage campaign costs are stored separately and survive pruning.
KOALABATTLE_DECISION_AUDIT_RETENTION_MATCHES=0
PUBLIC_API_URL=http://localhost:8001
PUBLIC_WS_URL=ws://localhost:8001
PUBLIC_RENDER_API_URL=http://localhost:8001
KOALABATTLE_FRONTEND_PORT=3000
# docker-compose binds published ports to 127.0.0.1 by default. Set to 0.0.0.0 to expose
# services on your LAN/all interfaces (only do this on trusted networks).
KOALABATTLE_BIND_HOST=127.0.0.1
# Provider credentials are read only by the backend. Never prefix them with PUBLIC_.
KOALABATTLE_OPENAI_API_KEY=
KOALABATTLE_GEMINI_API_KEY=
KOALABATTLE_ANTHROPIC_API_KEY=
# Current selectable API models: deepseek-v4-flash (default) and deepseek-v4-pro.
KOALABATTLE_DEEPSEEK_API_KEY=
KOALABATTLE_OPENAI_COMPATIBLE_API_KEY=
# Host development writes here; Docker overrides this with its mounted /runtime-config/.env.
KOALABATTLE_PROVIDER_CREDENTIALS_FILE=.env
KOALABATTLE_ENABLE_FAKE_PROVIDER=false
KOALABATTLE_MAX_CONCURRENT_MATCHES=2
KOALABATTLE_PRICING_VERSION=unconfigured
KOALABATTLE_PRICING_TABLE_JSON={}
# Speech defaults to free online Edge neural voices; basic local system speech is the fallback.
# Windows/Docker needs no MLX: keep `system`, or configure `openai-compatible` below.
KOALABATTLE_SPEECH_PROVIDER=system
KOALABATTLE_SPEECH_AUDIO_ROOT=data/audio
KOALABATTLE_SPEECH_QWEN_BASE_URL=http://host.docker.internal:8890/v1
KOALABATTLE_SPEECH_QWEN_ENDPOINT=/audio/speech
KOALABATTLE_SPEECH_QWEN_MODEL=mlx-community/Qwen3-TTS-12Hz-1.7B-Base-8bit
KOALABATTLE_SPEECH_QWEN_API_KEY=
KOALABATTLE_SPEECH_QWEN_REFERENCE_ROOT=data/audio/voices
KOALABATTLE_SPEECH_QWEN_TIMEOUT_SECONDS=300
KOALABATTLE_SPEECH_QWEN_MAX_RETRIES=1
KOALABATTLE_SPEECH_QWEN_MAX_CONCURRENCY=1
KOALABATTLE_SPEECH_EDGE_ENABLED=true
KOALABATTLE_SPEECH_EDGE_VOICE_P1=en-US-EmmaMultilingualNeural
KOALABATTLE_SPEECH_EDGE_VOICE_P2=en-US-BrianMultilingualNeural
KOALABATTLE_SPEECH_EDGE_VOICE_NARRATOR=en-US-GuyNeural
KOALABATTLE_SPEECH_MAX_CONCURRENCY=8
KOALABATTLE_SPEECH_MAX_TEXT_CHARACTERS=1000
KOALABATTLE_SPEECH_OPENAI_MODEL=gpt-4o-mini-tts
KOALABATTLE_SPEECH_OPENAI_BASE_URL=
KOALABATTLE_SPEECH_OPENAI_API_KEY=
# User-uploaded logos, backgrounds, watermarks and fonts. Runtime media, never committed.
KOALABATTLE_BRANDING_ROOT=data/branding
# Generated videos and renderer work files stay outside Git under data/videos.
KOALABATTLE_VIDEO_ROOT=data/videos
KOALABATTLE_VIDEO_MAX_CONCURRENCY=1
KOALABATTLE_VIDEO_FRAME_WORKERS=4
# Leave false for Docker Compose: the renderer profile owns rendering, and the backend image
# ships no Chromium/Playwright. Set to true only when running the backend directly on the host.
KOALABATTLE_VIDEO_WORKER_ENABLED=false
KOALABATTLE_VIDEO_FRONTEND_URL=http://localhost:3000
KOALABATTLE_VIDEO_API_URL=http://localhost:8001
KOALABATTLE_VIDEO_FFMPEG_PATH=ffmpeg
KOALABATTLE_VIDEO_FFPROBE_PATH=ffprobe
KOALABATTLE_VIDEO_CHROMIUM_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# OBS Studio 28+ includes obs-websocket v5. Credentials never enter Browser Source URLs.
KOALABATTLE_OBS_HOST=127.0.0.1
KOALABATTLE_OBS_PORT=4455
KOALABATTLE_OBS_PASSWORD=
KOALABATTLE_OBS_SCENE=KoalaBattle
KOALABATTLE_OBS_BROWSER_SOURCE=KoalaBattle
