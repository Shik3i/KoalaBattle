KOALABATTLE_DATABASE_URL=sqlite+aiosqlite:///./data/koalabattle.db
KOALABATTLE_SHOWDOWN_WEBSOCKET_URL=ws://localhost:8000/showdown/websocket
KOALABATTLE_SHOWDOWN_AUTH_URL=https://play.pokemonshowdown.com/action.php?
KOALABATTLE_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
PUBLIC_API_URL=http://localhost:8001
PUBLIC_WS_URL=ws://localhost:8001
KOALABATTLE_FRONTEND_PORT=3000
# Provider credentials are read only by the backend. Never prefix them with PUBLIC_.
KOALABATTLE_OPENAI_API_KEY=
KOALABATTLE_GEMINI_API_KEY=
KOALABATTLE_ANTHROPIC_API_KEY=
KOALABATTLE_DEEPSEEK_API_KEY=
KOALABATTLE_OPENAI_COMPATIBLE_API_KEY=
KOALABATTLE_ENABLE_FAKE_PROVIDER=false
KOALABATTLE_MAX_CONCURRENT_MATCHES=2
KOALABATTLE_PRICING_VERSION=unconfigured
KOALABATTLE_PRICING_TABLE_JSON={}
